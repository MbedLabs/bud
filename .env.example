BUD_ENV=production
# Image tag to run. Production: pin an immutable version (e.g. 1.0.0) or use
# `stable` (newest stable release). `latest` is the rolling dev build from main
# and must NOT be used in production.
BUD_VERSION=stable
DB_USER=bud
DB_PASSWORD=replace-with-a-strong-database-password
DB_NAME=buddb
SECRET_KEY=replace-with-a-strong-random-secret
RUNNER_API_KEY=replace-with-a-shared-runner-registration-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_FULL_NAME=Bud Admin
APP_BASE_URL=http://localhost:8001
FRONTEND_BASE_URL=http://localhost:8001
BUD_APP_URL=http://localhost:8001
# Optional sidebar link to Bloom. The result-sync destination itself is saved by
# an administrator in Bud Settings.
BLOOM_APP_URL=
# Required only when Bud → Bloom result sync is configured. Generate once with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BUD_INTEGRATION_ENCRYPTION_KEY=
# SMTP is optional for a single pre-seeded administrator, but required for
# invitations, password resets, and approved email changes.
SMTP_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM_EMAIL=noreply@example.com
SMTP_REPLY_TO=support@example.com
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_TIMEOUT_SECONDS=30
INVITE_TOKEN_TTL_HOURS=72
EMAIL_VERIFICATION_TOKEN_TTL_HOURS=24
PASSWORD_RESET_TOKEN_TTL_HOURS=2
RUN_STARTUP_DATA_REPAIR=false
AUTO_SEED_ADMIN=false
ENABLE_DOCS=false
LOG_LEVEL=INFO
LOG_JSON=true
ENABLE_METRICS=true
# Artifact uploads default to 25 MiB. Operators may raise this to at most
# 104857600 (100 MiB) for trace-heavy runners.
BUD_UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_BYTES=26214400
MAX_RUN_UPLOAD_BYTES=262144000
MIN_UPLOAD_FREE_BYTES=1073741824
UPLOADS_PER_15_MINUTES=10
MAX_CONCURRENT_UPLOADS_PER_PRINCIPAL=1
ARTIFACT_RETENTION_DAYS=30
UPLOAD_STREAM_CHUNK_BYTES=1048576
