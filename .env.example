BUD_ENV=production
BUD_VERSION=latest
DB_USER=bud
DB_PASSWORD=replace-with-a-strong-database-password
DB_NAME=buddb
SECRET_KEY=replace-with-a-strong-random-secret
RUNNER_API_KEY=replace-with-a-shared-runner-registration-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_FULL_NAME=Bud Admin
APP_BASE_URL=http://localhost:8001
FRONTEND_BASE_URL=http://localhost:8001
BUD_APP_URL=http://localhost:8001
BLOOM_APP_URL=http://localhost:8000
BLOOM_SYNC_ENABLED=true
SMTP_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=Bud
SMTP_REPLY_TO=support@example.com
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_TIMEOUT_SECONDS=30
INVITE_TOKEN_TTL_HOURS=72
EMAIL_VERIFICATION_TOKEN_TTL_HOURS=24
PASSWORD_RESET_TOKEN_TTL_HOURS=2
RUN_STARTUP_DATA_REPAIR=false
AUTO_SEED_ADMIN=true
ENABLE_DOCS=false
LOG_LEVEL=INFO
LOG_JSON=true
ENABLE_METRICS=true
